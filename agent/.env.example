# NOVA-APEX local configuration
# Keep secrets in your untracked .env file or in the OS credential manager.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=auto
DEFAULT_MODEL=gemini-2.5-flash

# Browser: standard Playwright behavior, no anti-bot evasion or automatic session persistence
BROWSER_HEADLESS=false
BROWSER_PERSIST_SESSION=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# Android ADB
ADB_ENABLED=true
ADB_DEVICE_ID=
ADB_HOST=127.0.0.1
ADB_PORT=5037

# High-impact capabilities are disabled until deliberately enabled by the local operator.
ALLOW_SHELL_EXECUTION=false
ALLOW_DESTRUCTIVE_ACTIONS=false
DESKTOP_SAFETY_FAILSAFE=true
DESKTOP_ACTION_PAUSE=0.2

# Local-only Mission Control server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WORKSPACE_DIR=./workspace
