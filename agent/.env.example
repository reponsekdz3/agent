# NOVA-APEX Autonomous System Configuration
# LLM Providers (Configure at least one for LLM reasoning, or agent will use its built-in Autonomous Heuristic Planner)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Active Provider: "gemini", "openai", "anthropic", "ollama", or "auto"
DEFAULT_LLM_PROVIDER=auto
DEFAULT_MODEL=gemini-2.5-flash

# Controller Settings
BROWSER_HEADLESS=false
BROWSER_STEALTH=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# Mobile Settings (ADB)
ADB_ENABLED=true
ADB_DEVICE_ID=
ADB_HOST=127.0.0.1
ADB_PORT=5037

# Desktop & Safety Boundaries
DESKTOP_SAFETY_FAILSAFE=true
DESKTOP_ACTION_PAUSE=0.2

# Server & UI
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Required for dashboard login, including on loopback. Set a unique value of at least 16 characters.
NOVA_APEX_AUTH_PASSWORD=
NOVA_APEX_COOKIE_SECURE=true
NOVA_APEX_SESSION_TTL_SECONDS=28800
WORKSPACE_DIR=workspace
